---
import { getCollection } from 'astro:content';
import Layout from '@/layouts/Layout.astro';
import Header from '@/components/Header.astro';
import Hero from '@/components/Hero.astro';
import Catalogo from '@/components/Catalogo';
import Planes from '@/components/Planes.astro';
import FAQ from '@/components/FAQ';
import Contacto from '@/components/Contacto.astro';
import Footer from '@/components/Footer.astro';
import { SITE } from '@/config';

const items = (await getCollection('invitaciones'))
  .sort((a, b) => a.data.orden - b.data.orden)
  .map(({ id, data }) => ({
    slug: id,
    titulo: data.titulo,
    evento: data.evento,
    plan: data.plan,
    precio: data.precio,
    descripcion: data.descripcion,
    colores: data.colores,
    destacado: data.destacado,
    caracteristicas: data.caracteristicas,
    imagen: data.imagen,
  }));
---

<Layout>
  <Header />
  <main>
    <Hero />

    <section id="catalogo" class="bg-paper-100 py-16 sm:py-22">
      <div class="container-x">
        <div class="reveal flex flex-col justify-between gap-2 sm:flex-row sm:items-end">
          <h2 class="title">Elige tu invitación</h2>
          <p class="text-xs text-charcoal-600 sm:text-sm">Prueba la demo en vivo o pídela directo por WhatsApp</p>
        </div>
        <div class="mt-8">
          <Catalogo client:visible items={items} whatsapp={SITE.whatsapp} />
        </div>
      </div>
    </section>

    <Planes />

    <section id="faq" class="border-t border-charcoal-900/10 bg-paper-100 py-16 sm:py-22">
      <div class="container-x grid gap-8 lg:grid-cols-12 lg:gap-12">
        <div class="reveal min-w-0 lg:col-span-4">
          <h2 class="title">Preguntas frecuentes</h2>
        </div>
        <div class="min-w-0 lg:col-span-8">
          <FAQ client:visible />
        </div>
      </div>
    </section>

    <Contacto />
  </main>
  <Footer />
</Layout>
