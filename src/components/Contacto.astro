---
import { SITE, waLink } from '@/config';
---

<section id="contacto" class="bg-paper-100 py-16 sm:py-22">
  <div class="container-x">
    <div class="sheet-ivory reveal p-6 sm:p-10 lg:p-12">
      <div class="grid items-center gap-6 lg:grid-cols-12 lg:gap-8">
        <div class="min-w-0 lg:col-span-7">
          <h2 class="title">Cuéntanos qué celebras y revisamos tu invitación hoy</h2>
          <p class="mt-3 max-w-xl text-xs leading-5 text-charcoal-600 sm:text-sm sm:leading-6">
            Indícanos la fecha tentativa de tu evento, el modelo del catálogo que te gustó y si prefieres link general o control de cupos por familia.
          </p>
        </div>

        <div class="flex flex-col gap-3 sm:flex-row lg:col-span-5 lg:flex-col xl:flex-row xl:justify-end">
          <a href={waLink()} target="_blank" rel="noopener" class="btn-primary w-full sm:w-auto lg:w-full xl:w-auto">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="shrink-0" aria-hidden="true">
              <path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.16-.17.2-.35.22-.64.08-.3-.15-1.26-.46-2.39-1.48-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.61-.92-2.21-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.07 2.88 1.21 3.07.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.63.71.23 1.36.2 1.87.12.57-.09 1.76-.72 2.01-1.41.25-.69.25-1.29.17-1.41-.07-.12-.27-.2-.57-.35zm-5.42 7.4h-.01a9.87 9.87 0 0 1-5.03-1.38l-.36-.21-3.74.98 1-3.65-.24-.37a9.86 9.86 0 0 1-1.51-5.26c0-5.45 4.44-9.88 9.89-9.88 2.64 0 5.12 1.03 6.99 2.9a9.83 9.83 0 0 1 2.89 6.99c0 5.45-4.44 9.88-9.88 9.88zm8.41-18.3A11.82 11.82 0 0 0 12.05 0C5.5 0 .16 5.34.16 11.89c0 2.1.55 4.14 1.59 5.95L.06 24l6.3-1.65a11.88 11.88 0 0 0 5.69 1.45h.01c6.55 0 11.89-5.34 11.89-11.89a11.82 11.82 0 0 0-3.48-8.41z" />
            </svg>
            <span>Escribir por WhatsApp</span>
          </a>
          <a href={`mailto:${SITE.email}`} class="btn-ghost w-full truncate font-mono text-xs sm:w-auto lg:w-full xl:w-auto">
            {SITE.email}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
