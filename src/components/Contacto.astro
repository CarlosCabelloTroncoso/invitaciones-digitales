---
import { SITE, waLink } from '@/config';
---

<section id="contacto" class="py-20 sm:py-26">
  <div class="container-x">
    <div class="reveal card p-6 sm:p-12">
      <div class="grid items-center gap-8 lg:grid-cols-12">
        <div class="min-w-0 lg:col-span-7">
          <p class="section-label">Reserva de fecha</p>
          <h2 class="title mt-3">Cuéntanos qué celebras y revisamos tu invitación hoy</h2>
          <p class="mt-3 max-w-xl text-sm leading-6 text-mist-300">
            Indícanos la fecha tentativa de tu evento, el modelo del catálogo que te gustó y si prefieres link general o control de cupos por familia.
          </p>
        </div>

        <div class="flex flex-col gap-3 sm:flex-row lg:col-span-5 lg:justify-end">
          <a href={waLink()} target="_blank" rel="noopener" class="btn-primary w-full sm:w-auto">
            Escribir por WhatsApp
          </a>
          <a href={`mailto:${SITE.email}`} class="btn-ghost w-full font-mono text-xs sm:w-auto">
            {SITE.email}
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
