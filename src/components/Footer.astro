---
import { SITE, waLink } from '@/config';
const year = new Date().getFullYear();
---

<footer class="border-t border-charcoal-900/10 bg-paper-200 pt-14 pb-[max(2.75rem,env(safe-area-inset-bottom))] sm:pt-16">
  <div class="container-x">
    <div class="grid gap-10 pb-12 sm:grid-cols-2 lg:grid-cols-12 lg:gap-8">
      <!-- 1. Marca y propuesta -->
      <div class="sm:col-span-2 lg:col-span-5">
        <a href="/" class="inline-flex items-center" aria-label={SITE.nombre}>
          <img
            src={SITE.logo}
            alt={SITE.nombre}
            width="132"
            height="46"
            class="h-8 w-auto"
            loading="lazy"
          />
        </a>
        <p class="mt-4 max-w-sm text-xs leading-5 text-charcoal-600 sm:text-sm sm:leading-6">
          Invitaciones digitales interactivas con sobre 3D, mapa con ubicación exacta y confirmación de asistencia en tiempo real para eventos en todo Chile.
        </p>
        <div class="mt-4 inline-flex items-center gap-2 rounded-[6px] border border-charcoal-900/12 bg-paper-50 px-3 py-1.5 font-mono text-[11px] text-charcoal-700 num">
          <span class="h-1.5 w-1.5 rounded-full bg-gold-400"></span>
          <span>Entrega garantizada en 48 horas hábiles</span>
        </div>
      </div>

      <!-- 2. Navegación rápida -->
      <div class="lg:col-span-3">
        <p class="font-mono text-xs text-charcoal-400">Secciones</p>
        <ul class="mt-4 space-y-2.5 text-xs text-charcoal-700 sm:text-sm">
          <li>
            <a href="#catalogo" class="transition-colors hover:text-charcoal-900">Catálogo de diseños</a>
          </li>
          <li>
            <a href="#planes" class="transition-colors hover:text-charcoal-900">Planes y precios</a>
          </li>
          <li>
            <a href="#faq" class="transition-colors hover:text-charcoal-900">Preguntas frecuentes</a>
          </li>
          <li>
            <a href="/demos/boda-elegante/" class="font-medium text-indigo-900 transition-colors hover:text-indigo-700">
              Probar Demo Sobre 3D →
            </a>
          </li>
        </ul>
      </div>

      <!-- 3. Contacto directo (WhatsApp y Correo) -->
      <div class="lg:col-span-4">
        <p class="font-mono text-xs text-charcoal-400">Contacto directo</p>
        <div class="mt-4 flex flex-col gap-2.5">
          <a
            href={waLink()}
            target="_blank"
            rel="noopener"
            class="group flex items-center gap-3 rounded-[10px] border border-charcoal-900/12 bg-paper-50 p-3 transition-colors hover:border-charcoal-900/25 hover:bg-white"
          >
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-[8px] bg-paper-200 text-charcoal-900 transition-colors group-hover:bg-charcoal-900 group-hover:text-paper-50">
              <svg width="17" height="17" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.16-.17.2-.35.22-.64.08-.3-.15-1.26-.46-2.39-1.48-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.61-.92-2.21-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.07 2.88 1.21 3.07.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.63.71.23 1.36.2 1.87.12.57-.09 1.76-.72 2.01-1.41.25-.69.25-1.29.17-1.41-.07-.12-.27-.2-.57-.35zm-5.42 7.4h-.01a9.87 9.87 0 0 1-5.03-1.38l-.36-.21-3.74.98 1-3.65-.24-.37a9.86 9.86 0 0 1-1.51-5.26c0-5.45 4.44-9.88 9.89-9.88 2.64 0 5.12 1.03 6.99 2.9a9.83 9.83 0 0 1 2.89 6.99c0 5.45-4.44 9.88-9.88 9.88zm8.41-18.3A11.82 11.82 0 0 0 12.05 0C5.5 0 .16 5.34.16 11.89c0 2.1.55 4.14 1.59 5.95L.06 24l6.3-1.65a11.88 11.88 0 0 0 5.69 1.45h.01c6.55 0 11.89-5.34 11.89-11.89a11.82 11.82 0 0 0-3.48-8.41z" />
              </svg>
            </span>
            <div class="min-w-0">
              <p class="text-[11px] text-charcoal-400">WhatsApp de atención</p>
              <p class="truncate font-mono text-xs font-medium text-charcoal-900 num">{SITE.whatsappDisplay}</p>
            </div>
          </a>

          <a
            href={`mailto:${SITE.email}`}
            class="group flex items-center gap-3 rounded-[10px] border border-charcoal-900/12 bg-paper-50 p-3 transition-colors hover:border-charcoal-900/25 hover:bg-white"
          >
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-[8px] bg-paper-200 text-charcoal-900 transition-colors group-hover:bg-charcoal-900 group-hover:text-paper-50">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
                <rect x="3" y="5" width="18" height="14" rx="2" />
                <path d="m3 7 9 6 9-6" />
              </svg>
            </span>
            <div class="min-w-0">
              <p class="text-[11px] text-charcoal-400">Correo electrónico</p>
              <p class="truncate font-mono text-xs font-medium text-charcoal-900">{SITE.email}</p>
            </div>
          </a>
        </div>
      </div>
    </div>

    <!-- Línea inferior de cierre legal -->
    <div class="flex flex-col items-start justify-between gap-2 border-t border-charcoal-900/10 pt-6 text-xs text-charcoal-600 sm:flex-row sm:items-center">
      <p class="num">© {year} {SITE.nombre} · Todos los derechos reservados.</p>
      <p>{SITE.ciudad}</p>
    </div>
  </div>
</footer>

<!-- Botón flotante de WhatsApp blanco/carbón elegante -->
<a
  href={waLink()}
  target="_blank"
  rel="noopener"
  aria-label="Contactar por WhatsApp"
  title="Contactar por WhatsApp"
  class="fixed bottom-[max(1.25rem,env(safe-area-inset-bottom))] right-[max(1rem,env(safe-area-inset-right))] z-40 flex h-13 w-13 items-center justify-center rounded-full border border-charcoal-900/14 bg-charcoal-900 text-paper-50 shadow-[0_12px_28px_-8px_rgba(18,18,20,0.45)] transition-all duration-150 hover:scale-105 hover:bg-indigo-900 active:scale-95 sm:right-[max(1.5rem,env(safe-area-inset-right))]"
>
  <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d="M17.47 14.38c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.16-.17.2-.35.22-.64.08-.3-.15-1.26-.46-2.39-1.48-.88-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.03-.52-.07-.15-.67-1.61-.92-2.21-.24-.58-.49-.5-.67-.51h-.57c-.2 0-.52.07-.79.37-.27.3-1.04 1.02-1.04 2.48 0 1.46 1.07 2.88 1.21 3.07.15.2 2.1 3.2 5.08 4.49.71.31 1.26.49 1.69.63.71.23 1.36.2 1.87.12.57-.09 1.76-.72 2.01-1.41.25-.69.25-1.29.17-1.41-.07-.12-.27-.2-.57-.35zm-5.42 7.4h-.01a9.87 9.87 0 0 1-5.03-1.38l-.36-.21-3.74.98 1-3.65-.24-.37a9.86 9.86 0 0 1-1.51-5.26c0-5.45 4.44-9.88 9.89-9.88 2.64 0 5.12 1.03 6.99 2.9a9.83 9.83 0 0 1 2.89 6.99c0 5.45-4.44 9.88-9.88 9.88zm8.41-18.3A11.82 11.82 0 0 0 12.05 0C5.5 0 .16 5.34.16 11.89c0 2.1.55 4.14 1.59 5.95L.06 24l6.3-1.65a11.88 11.88 0 0 0 5.69 1.45h.01c6.55 0 11.89-5.34 11.89-11.89a11.82 11.82 0 0 0-3.48-8.41z" />
  </svg>
</a>
