---
---

<section class="relative flex min-h-[76svh] items-center overflow-hidden border-b border-mist-100/8 bg-ink-900 pt-15 sm:min-h-[80svh]">
  <!-- Fotografía de estudio a la derecha, fundida con máscara suave -->
  <div class="pointer-events-none absolute inset-0">
    <img
      src="/visuals/hero-scene.jpg"
      alt="Sobre de papel algodón negro con sello de lacre en latón y tarjeta marfil"
      width="1600"
      height="900"
      fetchpriority="high"
      class="scene-mask h-full w-full object-cover object-[70%_center] opacity-85 sm:object-right sm:opacity-90"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-ink-900 via-ink-900/75 to-ink-900/35 sm:bg-gradient-to-r sm:from-ink-900 sm:via-ink-900/80 sm:to-transparent lg:via-ink-900/45"></div>
    <div class="absolute inset-x-0 bottom-0 h-28 bg-gradient-to-t from-ink-900 to-transparent"></div>
  </div>

  <div class="container-x relative py-14 sm:py-22 lg:py-26">
    <div class="max-w-[580px]">
      <p class="font-mono text-xs text-gold-400 num">
        Desde $9.990 CLP · Entrega en 48 horas
      </p>

      <h1 class="mt-3.5 font-display text-[clamp(2.25rem,6.5vw,4.15rem)] font-normal tracking-[-0.03em] leading-[1.04] text-mist-100">
        Invitaciones digitales para bodas y eventos
      </h1>

      <p class="mt-4 max-w-[30rem] text-sm leading-relaxed text-mist-300 sm:text-base">
        Diseños web con sobre 3D, ubicación en Waze y confirmación de asistencia en un solo link de WhatsApp.
      </p>

      <div class="mt-7 flex flex-col gap-3 sm:mt-8 sm:flex-row sm:items-center">
        <a href="#catalogo" class="btn-primary w-full sm:w-auto">
          Ver catálogo
        </a>
        <a href="/demos/boda-elegante/" class="btn-ghost w-full sm:w-auto">
          <span>Probar demo 3D</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-mist-300" aria-hidden="true">
            <path d="M7 17 17 7M9 7h8v8" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
