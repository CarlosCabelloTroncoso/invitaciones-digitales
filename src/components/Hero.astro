---
---

<section class="relative flex min-h-[78svh] items-center overflow-hidden border-b border-mist-100/8 bg-ink-900 pt-15">
  <!-- Fotografía de estudio a la derecha, espacio negro limpio a la izquierda -->
  <div class="pointer-events-none absolute inset-0">
    <img
      src="/visuals/hero-scene.jpg"
      alt="Sobre de papel algodón negro con sello de lacre en latón y tarjeta marfil"
      width="1600"
      height="900"
      fetchpriority="high"
      class="scene-mask h-full w-full object-cover object-[75%_center] opacity-90 sm:object-right"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-ink-900 via-ink-900/80 to-transparent lg:via-ink-900/45"></div>
    <div class="absolute inset-x-0 bottom-0 h-32 bg-gradient-to-t from-ink-900 to-transparent"></div>
  </div>

  <div class="container-x relative py-16 sm:py-24">
    <div class="max-w-[560px]">
      <p class="font-mono text-xs text-gold-400 num">
        Desde $9.990 CLP · Entrega en 48 horas
      </p>

      <h1 class="mt-4 font-display text-[42px] font-normal tracking-[-0.03em] leading-[1.03] text-mist-100 sm:text-[58px] lg:text-[66px]">
        Invitaciones digitales para bodas y eventos
      </h1>

      <p class="mt-4 max-w-[30rem] text-base leading-relaxed text-mist-300">
        Diseños web con sobre 3D, ubicación en Waze y confirmación de asistencia en un solo link de WhatsApp.
      </p>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:items-center">
        <a href="#catalogo" class="btn-primary w-full sm:w-auto">
          Ver catálogo
        </a>
        <a href="/demos/boda-elegante" class="btn-ghost w-full sm:w-auto">
          <span>Probar demo 3D</span>
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-mist-300" aria-hidden="true">
            <path d="M7 17 17 7M9 7h8v8" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>
