---
import { clp, SITE, waLink } from '@/config';
import CotizadorBodas from '@/components/CotizadorBodas';

const planes = [
  {
    nombre: 'Básica',
    precio: 9990,
    desc: 'Diseño del catálogo con tus datos.',
    items: [
      'Cuenta regresiva y mapa GPS (Waze / Maps)',
      'Confirmación a tu WhatsApp',
      'Link general con envíos ilimitados',
    ],
  },
  {
    nombre: 'Personalizada',
    precio: 19990,
    desc: 'Colores, fotos y música a tu gusto.',
    items: [
      'Todo lo del plan Básica',
      'Galería de fotos y música de fondo',
      'Dress code y datos de regalos / transferencia',
    ],
    destacado: true,
  },
  {
    nombre: 'Premium',
    precio: 34990,
    desc: 'Sobre 3D interactivo e itinerario completo.',
    items: [
      'Todo lo del plan Personalizada',
      'Sobre 3D que extrae la invitación al tocar',
      'Itinerario del evento y cambios ilimitados',
    ],
  },
];
---

<section id="planes" class="border-t border-mist-100/8 py-16 sm:py-20">
  <div class="container-x">
    <div class="reveal flex flex-col justify-between gap-2 sm:flex-row sm:items-end">
      <div>
        <p class="section-label">Precios</p>
        <h2 class="title mt-2">Planes de pago único</h2>
      </div>
      <p class="text-xs text-mist-400">
        Frente a $150.000+ en invitaciones impresas · Entrega en 48 h
      </p>
    </div>

    <div class="mt-8 grid gap-5 md:grid-cols-3">
      {planes.map((p) => (
        <article
          class:list={[
            'reveal flex min-w-0 flex-col justify-between rounded-[14px] p-5 sm:p-6',
            p.destacado ? 'surface-raised' : 'card',
          ]}
        >
          <div>
            <div class="flex items-center justify-between gap-2">
              <h3 class="text-base font-medium text-mist-100">{p.nombre}</h3>
              {p.destacado && <span class="pass-tag text-gold-300">Más elegido</span>}
            </div>

            <p class="mt-3 font-mono text-[28px] font-medium leading-none text-mist-100 num">{clp(p.precio)}</p>
            <p class="mt-2 text-xs text-mist-300">{p.desc}</p>

            <ul class="mt-5 space-y-2 border-t border-mist-100/8 pt-4 text-xs text-mist-100">
              {p.items.map((it) => (
                <li class="flex items-start gap-2">
                  <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="mt-0.5 w-4 shrink-0 text-gold-400" aria-hidden="true">
                    <path d="M20 6 9 17l-5-5" />
                  </svg>
                  <span>{it}</span>
                </li>
              ))}
            </ul>
          </div>

          <a
            href={waLink(`Hola, quiero el plan ${p.nombre} (${clp(p.precio)})`)}
            target="_blank"
            rel="noopener"
            class={p.destacado ? 'btn-primary mt-6 h-10 w-full text-xs' : 'btn-ghost mt-6 h-10 w-full text-xs'}
          >
            Elegir {p.nombre}
          </a>
        </article>
      ))}
    </div>

    <div class="reveal">
      <CotizadorBodas client:visible whatsapp={SITE.whatsapp} />
    </div>
  </div>
</section>
